{
  "name": "sankofa",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.25",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.57.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jsdom": "29.1.1",
    "tsx": "4.23.1",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  },
  "scripts": {
    "start": "expo start --tunnel",
    "dev": "expo start --tunnel",
    "start:clear": "expo start --tunnel --clear",
    "android": "expo start --tunnel --android",
    "ios": "expo start --tunnel --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:quiz": "tsx scripts/generate-mobile-quiz-index.ts",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "validate": "npm run verify:migration && npm --prefix web run validate",
    "export:android": "expo export --platform android --output-dir .expo/export-android",
    "export:ios": "expo export --platform ios --output-dir .expo/export-ios",
    "build": "expo export --platform android --platform ios --output-dir .expo/export-native",
    "install:web": "npm --prefix web ci",
    "dev:web": "npm --prefix web run dev --",
    "build:web": "npm --prefix web run build --",
    "preview:web": "npm --prefix web run preview --",
    "lint:web": "npm --prefix web run lint --",
    "typecheck:web": "npm --prefix web run typecheck --",
    "test:web": "npm --prefix web run test --",
    "validate:web": "npm --prefix web run validate"
  },
  "private": true,
  "description": "Sankofa — application mobile React Native / Expo SDK 57.",
  "engines": {
    "node": ">=22.13.0"
  }
}
