{
  "name": "sankofa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sankofa — l'application de culture générale africaine, gamifiée et mobile-first.",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:index && npm run gen:quiz && npm run validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "validate": "tsx --tsconfig tsconfig.app.json scripts/validate-content.ts",
    "gen:index": "tsx --tsconfig tsconfig.app.json scripts/generate-course-index.ts",
    "gen:quiz": "tsx --tsconfig tsconfig.app.json scripts/generate-quiz-index.ts",
    "icons": "node scripts/generate-icons.mjs",
    "images:generate": "node scripts/generate-course-images.mjs",
    "images:variants": "node scripts/generate-image-variants.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gen:map": "node scripts/generate-africa-map.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
